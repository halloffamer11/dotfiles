#!/usr/bin/env python3
import datetime
import os
from pathlib import Path
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path.home() / ".local/lib/fleet"))
from declarations import batch_ssh, edited_targets

state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "fleet/last-sync"
env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}


def run(args, *, cwd=None, capture=False, timeout=600):
    return subprocess.run(args, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE if capture else None, text=True,
                          check=True, timeout=timeout).stdout


def sync():
    source = run(["chezmoi", "source-path"], capture=True).strip()
    if run(["git", "status", "--porcelain", "--untracked-files=all"], cwd=source, capture=True):
        return "dirty source checkout"
    status = run(["chezmoi", "status", "--exclude=scripts"], capture=True)
    managed = run(["chezmoi", "managed", "--path-style=all", "--format=json"], capture=True)
    edited = edited_targets(status, managed)
    if edited:
        return "edited deployed target: " + ", ".join(edited)
    env.update(batch_ssh(source))
    run(["git", "pull", "--ff-only"], cwd=source)
    run(["chezmoi", "apply", "--no-tty", "--error-on-conflict"], cwd=Path.home())
    run(["skills", "update", "-g", "-y"], cwd=Path.home())


try:
    reason = sync()
except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
    reason = "failed: " + " ".join(exc.cmd)
except OSError as exc:
    reason = str(exc)

result = ("stopped: " + reason) if reason else "ok"
state.parent.mkdir(parents=True, exist_ok=True)
with tempfile.NamedTemporaryFile(mode="w", dir=state.parent, delete=False) as tmp:
    tmp.write(f"{datetime.datetime.now().astimezone().isoformat(timespec='seconds')} {result}\n")
os.replace(tmp.name, state)
if reason:
    print(result, file=sys.stderr)
    notification = (["osascript", "-e", 'on run argv\n display notification (item 1 of argv) with title "fleet-sync"\nend run', result]
                    if sys.platform == "darwin" else ["notify-send", "fleet-sync", result])
    try:
        subprocess.run(notification, stdin=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass
    sys.exit(1)
