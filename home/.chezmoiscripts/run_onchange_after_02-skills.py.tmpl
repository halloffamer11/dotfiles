#!/usr/bin/env python3
# Site skills: {{ $path := joinPath .chezmoi.homeDir ".config/fleet/site/skills.toml" }}{{ if stat $path }}{{ include $path | sha256sum }}{{ end }}
# Selection code: {{ include "dot_local/lib/fleet/declarations.py" | sha256sum }}
import base64
import json
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path.home() / ".local/lib/fleet"))
from declarations import selections

{{- $packs := includeTemplate "site-table" (dict "home" .chezmoi.homeDir "file" "skills.toml" "key" "packs" "base" .packs) | fromJson }}
data = json.loads(base64.b64decode("{{ dict "platform" .platform "packs" $packs.entries "selectedPacks" .selectedPacks "skillSelection" (get . "skillSelection" | default dict) | toJson | b64enc }}"))
for repo, skills in selections(data):
    subprocess.run(["skills", "add", repo, "-g", "-y", "-s", *skills, "-a",
                    "claude-code", "codex", "antigravity-cli"],
                   stdin=subprocess.DEVNULL, timeout=300, check=True)
