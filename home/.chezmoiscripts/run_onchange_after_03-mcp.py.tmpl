#!/usr/bin/env python3
# Site MCP: {{ $path := joinPath .chezmoi.homeDir ".config/fleet/site/mcp.toml" }}{{ if stat $path }}{{ include $path | sha256sum }}{{ end }}
# Validation: {{ include "dot_local/lib/fleet/declarations.py" | sha256sum }}
import base64
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path.home() / ".local/lib/fleet"))
from declarations import HOME, MCP_FILES, installed_harnesses, mcp_arguments, table


def run(harness, action, args, env=None):
    # CLI output can include values from unrelated, locally configured entries.
    try:
        subprocess.run([harness, "mcp", action, *args], env=env, cwd=HOME,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=30, check=True)
    except (OSError, subprocess.SubprocessError):
        raise SystemExit(f"{harness} mcp {action} failed for {name}") from None


entries = json.loads(base64.b64decode("{{ (includeTemplate "site-table" (dict "home" .chezmoi.homeDir "file" "mcp.toml" "key" "mcp" "base" .mcp) | fromJson).entries | toJson | b64enc }}"))
harnesses = installed_harnesses()
for harness, (path, key) in MCP_FILES.items():
    if harness not in harnesses:
        print(f"Skipping {harness} MCP entries: {harness} is not installed")
        continue
    existing = table(HOME / path, key)
    for name, item in entries.items():
        args, skip = mcp_arguments(harness, name, item, {{ .platform | toJson }})
        if skip:
            print(f"Skipping {harness} MCP {name}: {skip}")
            continue
        # Codex and agy upsert in one call. Claude requires remove/add. Verify
        # its exact replacement in a disposable user scope before removing it.
        # Keep HOME: mise shims and wrappers find their installs through it.
        if harness == "claude" and name in existing:
            with tempfile.TemporaryDirectory() as config:
                run(harness, "add", args, {**os.environ, "CLAUDE_CONFIG_DIR": config})
            run(harness, "remove", ["-s", "user", name])
        run(harness, "add", args)
