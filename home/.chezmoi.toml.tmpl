{{- /* The Platform: macos, omarchy (Linux with an Omarchy marker) or linux (any other Linux). */ -}}
{{- $platform := "macos" -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $platform = "linux" -}}
{{- if or (stat "/usr/share/omarchy") (stat (joinPath .chezmoi.homeDir ".local/share/omarchy")) -}}{{- $platform = "omarchy" -}}{{- end -}}
{{- else if ne .chezmoi.os "darwin" -}}{{ fail "The Belt supports macOS and Linux" }}{{- end -}}
{{- $packs := (include ".chezmoidata/packs.toml" | fromToml).packs -}}
{{- $site := joinPath .chezmoi.homeDir ".config/fleet/site/skills.toml" -}}
{{- if stat $site -}}{{- $packs = mustMergeOverwrite $packs (get (include $site | fromToml) "packs" | default dict) -}}{{- end -}}
{{- $names := keys $packs | sortAlpha -}}
{{- $selected := promptMultichoiceOnce . "selectedPacks" "Packs" $names $names -}}
{{- $ids := promptStringOnce . "providerIDs" "T3 Antigravity instance IDs (space-separated)" "antigravity" -}}
sourceDir = {{ .chezmoi.workingTree | toJson }}
mode = "file"

[data]
platform = {{ $platform | toJson }}
selectedPacks = {{ $selected | toJson }}
providerIDs = {{ $ids | toJson }}
{{- with get . "skillSelection" }}
[data.skillSelection]
{{ . | toToml }}
{{- end }}
