{{- $tools := deepCopy .tools -}}
{{- $system := "/etc/mise/conf.d/omarchy-tools.toml" -}}
{{- if and (eq .platform "omarchy") (stat $system) -}}
  {{- range $name, $_ := (include $system | fromToml).tools -}}
    {{- $_ := unset $tools $name -}}
  {{- end -}}
{{- end -}}
{{ dict "tools" $tools | toToml }}
