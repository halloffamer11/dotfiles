[core]
	# Global hooks: gitleaks before each commit, then the repository's own hook.
	hooksPath = ~/.config/git/hooks
[pull]
	rebase = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[user]
	name = dreiss
	email = ojhall11@gmail.com
# Last, so a machine's own settings (its identity first) win over the defaults above:
# git keeps the last value it reads for a key.
[include]
	path = ~/.gitconfig.local
