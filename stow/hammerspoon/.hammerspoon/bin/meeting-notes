#!/usr/bin/python3
"""meeting-notes — recording directory -> meeting.json, transcript.json (offline), notes.md (via the agent CLI).

  meeting-notes match <dir>        calendar event (local .ics only)      meeting_notes/match.py
  meeting-notes transcribe <dir>   speech to text + speakers, offline    meeting_notes/transcribe.py
  meeting-notes notes <dir>        hand off to this machine's agent CLI  meeting_notes/notes.py
  meeting-notes run <dir>          match -> transcribe -> notes          meeting_notes/pipeline.py
  meeting-notes queue              run every recording not yet processed
  meeting-notes doctor             read-only health check
  --force reruns a stage even when its fingerprints are unchanged; --if-enabled
  (run, queue) does nothing unless [run] auto_run = true (how Hammerspoon calls it).

Every stage: one lock per recording, atomic writes (mode 600), skipped when its
input fingerprints are unchanged, and never overwrites an output edited by hand
(the hash of what it wrote is kept in .meeting-notes-state.json).

Exit: 0 done or unchanged, 1 error, 4 refused (hand-edited output), 5 off
(notes command not set, or auto_run off with --if-enabled), 75 busy (locked).

Settings: ~/.config/meeting-notes/config.toml (or $MEETING_NOTES_CONFIG), never
committed. Only simple `key = value` lines under [section] headers are read;
sections and defaults are in meeting_notes/common.py (DEFAULTS).
"""
import os, sys

sys.dont_write_bytecode = True  # no __pycache__ under ~/.hammerspoon: it would trigger a config reload
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from meeting_notes.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
