#!/bin/bash
# record-meeting — one meeting recording: system audio (Core Audio tap, via
# audiotee) + default mic (ffmpeg), mixed to a single m4a in ~/Recordings with
# a JSON sidecar (start/end times) for the downstream transcription pipeline.
# Runs standalone (Ctrl-C to stop) or under Hammerspoon (hs.task:interrupt()).
# Both legs record headerless raw PCM (s16le/48k/mono): valid at any truncation
# point, so double-SIGINT delivery (process-group signal + trap forward) is harmless.
set -u
# Job control: each background child gets its own process group, so a group-wide
# SIGINT (hs.task interrupt / terminal Ctrl-C) reaches only this script and the
# trap forwards exactly one SIGINT per child — ffmpeg treats a second one as
# "abandon output immediately", which loses the recording.
set -m

REC_DIR="${RECORDINGS_DIR:-$HOME/Recordings}"
AUDIOTEE="$HOME/.local/bin/audiotee"
FFMPEG="/opt/homebrew/bin/ffmpeg"
BASE="$REC_DIR/meeting-$(date +%Y-%m-%d-%H%M%S)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/record-meeting.XXXXXX")"
RAW_FMT=(-f s16le -ar 48000 -ac 1)

mkdir -p "$REC_DIR"
START_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
START_EPOCH=$(date +%s)
CAP_DUR=86400  # cap mux at stop-time when stop is requested; 24h runaway guard otherwise

"$AUDIOTEE" --sample-rate 48000 > "$TMP/system.raw" 2> "$TMP/audiotee.log" &
AT_PID=$!
"$FFMPEG" -hide_banner -nostdin -f avfoundation -i ":default" \
  -ar 48000 -ac 1 -c:a pcm_s16le -f s16le -flush_packets 1 "$TMP/mic.raw" 2> "$TMP/ffmpeg-mic.log" &
FF_PID=$!

# First signal: forward SIGINT once to each leg, then ignore further INT/TERM so
# a stray repeat can't kill this script during the mux. AudioTee intermittently
# misses SIGINT, so escalate fast — TERM at 2s, KILL at 6s. Raw output plus
# per-packet flush keep both legs valid at any truncation point, and the mux
# trims to the requested stop time, so a laggard leg costs nothing.
STOP_AT=""
stop() {
  trap '' INT TERM
  STOP_AT=$SECONDS
  CAP_DUR=$(( $(date +%s) - START_EPOCH ))
  kill -INT "$AT_PID" "$FF_PID" 2>/dev/null
}
trap stop INT TERM

while kill -0 "$AT_PID" 2>/dev/null || kill -0 "$FF_PID" 2>/dev/null; do
  if [ -n "$STOP_AT" ]; then
    if [ $((SECONDS - STOP_AT)) -ge 6 ]; then
      kill -KILL "$AT_PID" "$FF_PID" 2>/dev/null
    elif [ $((SECONDS - STOP_AT)) -ge 2 ]; then
      kill -TERM "$AT_PID" "$FF_PID" 2>/dev/null
    fi
    sleep 0.2
  else
    wait "$AT_PID" "$FF_PID" 2>/dev/null
  fi
done
wait "$AT_PID" "$FF_PID" 2>/dev/null

END_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

have_sys=$([ -s "$TMP/system.raw" ] && echo 1 || echo 0)
have_mic=$([ -s "$TMP/mic.raw" ] && echo 1 || echo 0)

mux_ok=0
if [ "$have_sys" = 1 ] && [ "$have_mic" = 1 ]; then
  "$FFMPEG" -hide_banner -nostdin -loglevel error \
    "${RAW_FMT[@]}" -i "$TMP/system.raw" "${RAW_FMT[@]}" -i "$TMP/mic.raw" \
    -filter_complex "[1:a]volume=6dB[mic];[0:a][mic]amix=inputs=2:duration=longest" \
    -t "$CAP_DUR" -c:a aac -b:a 96k "$BASE.m4a" 2> "$TMP/ffmpeg-mux.log" && mux_ok=1
elif [ "$have_sys" = 1 ] || [ "$have_mic" = 1 ]; then
  # Salvage: one leg died — keep the other rather than losing the meeting
  [ "$have_sys" = 1 ] && SOLE="$TMP/system.raw" || SOLE="$TMP/mic.raw"
  "$FFMPEG" -hide_banner -nostdin -loglevel error \
    "${RAW_FMT[@]}" -i "$SOLE" -t "$CAP_DUR" -c:a aac -b:a 96k "$BASE.m4a" \
    2> "$TMP/ffmpeg-mux.log" && mux_ok=1
  echo "warning: one capture leg was empty (system=$have_sys mic=$have_mic); saved the other" >&2
fi

if [ "$mux_ok" = 1 ]; then
  printf '{\n  "audio": "%s",\n  "started": "%s",\n  "ended": "%s",\n  "system_leg": %s,\n  "mic_leg": %s\n}\n' \
    "$BASE.m4a" "$START_ISO" "$END_ISO" "$have_sys" "$have_mic" > "$BASE.json"
  rm -rf "$TMP"
  echo "$BASE.m4a"
else
  echo "recording failed; intermediates kept in $TMP" >&2
  exit 1
fi
