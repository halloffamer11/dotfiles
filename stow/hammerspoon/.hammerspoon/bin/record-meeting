#!/bin/bash
# record-meeting — one meeting recording: system audio (Core Audio tap, via
# audiotee) + default mic (mictee, our AVAudioEngine capturer — ffmpeg's
# avfoundation input drops mic buffers under load, measured 58-75% loss).
# Output: one directory per recording, ~/Recordings/meeting-<ts>/ (mode 700):
#   master.caf      lossless 48 kHz float, ch0 = mic, ch1 = system, one timeline
#   <id>.m4a        stereo listening copy of master.caf (mic left +6dB, system right, limiter, 256k AAC)
#   recording.json  format_version 1: id, requested/actual times, channel roles,
#                   per-leg health (exit status, samples, start offset, gaps), state
# Stdout: the recording directory. Exit status:
#   0  recorded — both legs captured
#   3  partial  — one leg empty or ended early; its channel is silence (files written)
#   1  failed   — preflight, or nothing usable; raw legs and logs kept in $TMPDIR
# Older recordings are flat meeting-<ts>.m4a + .json files; nothing here touches them.
# Runs standalone (Ctrl-C to stop) or under Hammerspoon (hs.task:interrupt()).
# Both legs record headerless raw PCM (system: s16le, mic: f32le; 48k mono):
# valid at any truncation point, so late/duplicate signals cannot corrupt them.
# Sync: the legs are separate processes, so record-meeting-finalize puts both on
# one CLOCK_UPTIME_RAW timeline — mictee logs its first-sample host time and any
# gaps; the system leg's start is estimated from when its first data lands.
set -u
# Job control: each background child gets its own process group, so a group-wide
# SIGINT (hs.task interrupt / terminal Ctrl-C) reaches only this script and the
# trap forwards exactly one SIGINT per child — ffmpeg treats a second one as
# "abandon output immediately", which loses the recording.
set -m

REC_DIR="${RECORDINGS_DIR:-$HOME/Recordings}"
AUDIOTEE="$HOME/.local/bin/audiotee"
MICTEE="$HOME/.local/bin/mictee"
FFMPEG="/opt/homebrew/bin/ffmpeg"
HELPER="$(cd "$(dirname "$0")" && pwd)/record-meeting-finalize"
ID="meeting-$(date +%Y-%m-%d-%H%M%S)"
OUT="$REC_DIR/$ID"

# Preflight: fail fast and loud, not at the end of a meeting. A missing binary
# must not degrade into a silent one-leg recording via the salvage path.
[ -x "$AUDIOTEE" ] || { echo "record-meeting: $AUDIOTEE missing — run 'make audiotee' in ~/dotfiles" >&2; exit 1; }
[ -x "$MICTEE" ] || { echo "record-meeting: $MICTEE missing — run 'make mictee' in ~/dotfiles" >&2; exit 1; }
[ -x "$FFMPEG" ] || { echo "record-meeting: $FFMPEG missing — brew install ffmpeg" >&2; exit 1; }
[ -x "$HELPER" ] || { echo "record-meeting: $HELPER missing" >&2; exit 1; }

# Concurrency guard: a second simultaneous recording would crisscross capture
# streams. If another record-meeting script is alive, refuse; if capture legs
# are running with NO owning script, they're orphans from a hard kill — reap
# them so they can't pollute this recording.
OTHER="$(pgrep -f '/record-meeting$' | grep -vw "$$" || true)"
if [ -n "$OTHER" ]; then
  echo "record-meeting: another recording is already running (pid $OTHER) — stop it first (⌥⌘R or kill -INT $OTHER)" >&2
  exit 1
fi
STALE="$(pgrep -x audiotee || true; pgrep -x mictee || true)"
if [ -n "$STALE" ]; then
  echo "record-meeting: reaping orphaned capture processes from a previous hard-killed run: $STALE" >&2
  kill -TERM $STALE 2>/dev/null
  sleep 1
  kill -KILL $STALE 2>/dev/null
fi
# Failure-kept intermediates are for recovery, not forever: sweep after 7 days.
find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'record-meeting.*' -type d -mtime +7 -exec rm -rf {} + 2>/dev/null
mkdir -p "$REC_DIR" || { echo "record-meeting: cannot create $REC_DIR" >&2; exit 1; }
TMP="$(mktemp -d "${TMPDIR:-/tmp}/record-meeting.XXXXXX")" || { echo "record-meeting: mktemp failed" >&2; exit 1; }
read -r START_MONO START_EPOCH < <("$HELPER" now)

# First signal: forward SIGINT once to each live leg, then ignore further
# INT/TERM so a stray repeat can't kill this script during the mux. AudioTee
# intermittently misses SIGINT, so escalate — one TERM at 2s, KILL at 6s. Raw
# output plus per-packet flush keep both legs valid at any truncation point,
# and finalize trims to the stop time, so a laggard leg costs nothing.
# Known limit: SIGKILL of this script orphans both legs (untrappable; children
# are in their own process groups by design) — recover via Activity Monitor.
AT_PID=""
FF_PID=""
STOP_AT=""
STOP_MONO=0
STOP_EPOCH=""
stop() {
  trap '' INT TERM
  STOP_AT=$SECONDS
  [ -n "$AT_PID" ] && kill -INT "$AT_PID" 2>/dev/null
  [ -n "$FF_PID" ] && kill -INT "$FF_PID" 2>/dev/null
  read -r STOP_MONO STOP_EPOCH < <("$HELPER" now)
}
trap stop INT TERM  # installed BEFORE the spawns: no window where a stop orphans the legs

: > "$TMP/system.raw"
"$HELPER" watch "$TMP/system.raw" > "$TMP/system.first" 2>/dev/null &
WATCH_PID=$!
read -r SPAWN_MONO _ < <("$HELPER" now)
"$AUDIOTEE" --sample-rate 48000 > "$TMP/system.raw" 2> "$TMP/audiotee.log" &
AT_PID=$!
"$MICTEE" > "$TMP/mic.raw" 2> "$TMP/mictee.log" &
FF_PID=$!

# Poll branch sends each escalation signal at most once (TERM is ffmpeg's
# abandon-output trigger on repeat, same as INT). No wait needed inside the
# loop: bash job control reaps exited children asynchronously, so kill -0
# turns false on its own; the trailing wait collects exit statuses.
TERM_SENT=""
KILL_SENT=""
while kill -0 "$AT_PID" 2>/dev/null || kill -0 "$FF_PID" 2>/dev/null; do
  if [ -n "$STOP_AT" ]; then
    if [ -z "$KILL_SENT" ] && [ $((SECONDS - STOP_AT)) -ge 6 ]; then
      KILL_SENT=1; kill -KILL "$AT_PID" "$FF_PID" 2>/dev/null
    elif [ -z "$TERM_SENT" ] && [ $((SECONDS - STOP_AT)) -ge 2 ]; then
      TERM_SENT=1; kill -TERM "$AT_PID" "$FF_PID" 2>/dev/null
    fi
    sleep 0.2
  else
    wait "$AT_PID" "$FF_PID" 2>/dev/null
  fi
done
wait "$AT_PID" 2>/dev/null; AT_RC=$?
wait "$FF_PID" 2>/dev/null; FF_RC=$?
kill "$WATCH_PID" 2>/dev/null; wait "$WATCH_PID" 2>/dev/null

# Align, mux, validate, write recording.json. Raw legs go only after that passes.
"$HELPER" finalize --tmp "$TMP" --out "$OUT" --id "$ID" \
  --start-mono-ns "$START_MONO" --start-epoch-ns "$START_EPOCH" --spawn-ns "$SPAWN_MONO" \
  --stop-ns "$STOP_MONO" ${STOP_EPOCH:+--stop-epoch-ns "$STOP_EPOCH"} \
  --sys-rc "$AT_RC" --mic-rc "$FF_RC"
RC=$?
case "$RC" in
  0) rm -rf "$TMP"; echo "$OUT" ;;
  3) mkdir -p "$OUT/logs" && cp "$TMP"/*.log "$OUT/logs/" 2>/dev/null; rm -rf "$TMP"; echo "$OUT" ;;
  *) echo "recording failed; intermediates kept in $TMP" >&2; exit 1 ;;
esac
exit "$RC"
